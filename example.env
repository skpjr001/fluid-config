# Environment for fluid-config. Copy it and fill it in:
#   Docker Compose:  cp example.env .env                     (compose.yml reads .env)
#   systemd:         /etc/fluid-config/fluid-config.env      (enable EnvironmentFile= in the unit, chmod 600)
#   VM installer:    /opt/fluid-config/.env                  (created by deploy/install.sh)
# Never commit the filled-in copy: .env is git-ignored.

# Optional extra editor token for the console, on top of dynamic/admin.json.
# At least 16 characters; generate one with: openssl rand -hex 32
# When it is set on the first start, the generated admin.json holds no token.
FLUID_ADMIN_TOKEN=

# Secrets for "env:NAME" tokens in API files. Add one line per name you use, e.g.
#   "auth": {"tokens": ["ops=env:HOLIDAYS_TOKEN"]}  ->  HOLIDAYS_TOKEN=...
# An API whose env: variable is unset or empty fails validation (the last good
# version keeps serving). This one is used by examples/dynamic/apis/market/holidays.json.
HOLIDAYS_TOKEN=

# Export OpenTelemetry traces over OTLP/HTTP, e.g. http://otel-collector:4318
# (same as telemetry.otlp_endpoint in config.json, which wins when both are set).
# Empty: no tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
