{
  "name": "holidays",
  "version": "v1",
  "description": "NSE/BSE trading holidays",
  "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
  "auth": { "type": "bearer", "tokens": ["env:HOLIDAYS_TOKEN"], "read_public": true },
  "rate_limit_per_min": 600,
  "cache_seconds": 300,
  "cors_origins": ["https://www.arihantcapital.com"],
  "strict_fields": true,
  "fields": {
    "date":     { "type": "string", "format": "date", "required": true },
    "exchange": { "type": "string", "enum": ["NSE", "BSE", "MCX"], "required": true },
    "segment":  { "type": "string", "enum": ["EQ", "FO", "CD", "COM"] },
    "reason":   { "type": "string", "min": 2, "max": 120, "required": true }
  },
  "data": [
    { "id": 1, "date": "2026-01-26", "exchange": "NSE", "segment": "EQ", "reason": "Republic Day" },
    { "id": 2, "date": "2026-03-03", "exchange": "NSE", "segment": "EQ", "reason": "Holi" },
    { "id": 3, "date": "2026-08-15", "exchange": "BSE", "segment": "EQ", "reason": "Independence Day" },
    { "id": 4, "date": "2026-10-02", "exchange": "MCX", "segment": "COM", "reason": "Gandhi Jayanti" }
  ]
}
