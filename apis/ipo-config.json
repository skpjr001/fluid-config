{
  "name": "ipo-config",
  "version": "v1",
  "description": "Live IPO/NCD issue config consumed by the application platform",
  "id_field": "symbol",
  "methods": ["GET", "PATCH"],
  "auth": { "type": "api_key", "header": "X-API-Key", "tokens": ["sha256:5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8"] },
