    "close":     { "type": "string", "format": "date", "required": true },
    "price_band":{ "type": "object" },
    "lot_size":  { "type": "integer", "min": 1 },
    "upi_mandate_cutoff": { "type": "string", "format": "date-time" },
    "active":    { "type": "boolean" }
  },
